{
  "name": "sanity-plugin-iconify",
  "version": "5.0.1",
  "description": "Icon picker based on Iconify",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/waspeer/sanity-plugin-iconify#readme",
  "bugs": {
    "url": "https://github.com/waspeer/sanity-plugin-iconify/issues"
  },
  "license": "MIT",
  "author": "Wannes Salomé <mail@wannessalome.nl>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/waspeer/sanity-plugin-iconify.git"
  },
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s build:verify build:bundle build:check",
    "build:bundle": "tsdown",
    "build:check": "node scripts/check-dist.mjs",
    "build:verify": "plugin-kit verify-package --silent",
    "dev": "vite dev --config dev/vite.config.ts",
    "dev:dist": "vite build --config dev/vite.config.ts && vite preview --config dev/vite.config.ts",
    "generate-types": "node src/lib/generate-types",
    "prepublishOnly": "node scripts/check-dist.mjs",
    "release": "release-it",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dist": "PLUGIN_TARGET=dist playwright test",
    "test:e2e:setup": "tsx playwright/auth-setup.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.7",
    "@sanity/icons": "^5.2.1",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@tanstack/react-query": "^5.102.8",
    "change-case": "^5.4.4",
    "downshift": "^9.4.0",
    "ts-pattern": "^5.9.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify/json": "^2.2.526",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@sanity/pkg-utils": "^12.3.4",
    "@sanity/plugin-kit": "^10.0.9",
    "@sanity/ui": "^4.2.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.0",
    "lefthook": "^2.1.12",
    "npm-run-all2": "^9.0.3",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "release-it": "^21.0.2",
    "sanity": "^6.13.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@sanity/ui": "^4.0.1",
    "react": "^19.2",
    "sanity": "^6.9.2",
    "styled-components": "^6"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@<2.0.3": ">=2.0.3",
      "minimatch@<10.2.3": ">=10.2.3",
      "picomatch@<4.0.4": ">=4.0.4"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    }
  },
  "sanityPlugin": {
    "verifyPackage": {
      "bannedFiles": false,
      "esmOnly": false,
      "nodeEngine": false,
      "oxfmt": false,
      "oxlint": false,
      "pkg-utils": false,
      "scripts": false,
      "tsconfig": false
    }
  }
}
